# IoT Client Configuration

# Backend Server
BACKEND_URL=ws://192.168.1.100:8000/ws/gemini

# Mock Mode (để test không cần hardware)
MOCK_MODE=false

# GPIO Pins (BCM numbering)
GPIO_LIVING_ROOM=17
GPIO_BEDROOM=27
GPIO_KITCHEN=22
GPIO_BALCONY=23

# Camera Settings
CAMERA_DEVICE_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_CAPTURE_INTERVAL=0.5
CAMERA_JPEG_QUALITY=75
CAMERA_MAX_DIMENSION=720

# Audio Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1600

# WebSocket Settings
WS_RECONNECT_DELAY=3.0
WS_PING_INTERVAL=10.0
WS_PING_TIMEOUT=30.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/iot-client.log
