# Application Configuration
APP_NAME=IoT Smart Home

# API Keys
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Gemini Model Configuration
GEMINI_MODEL=gemini-live-2.5-flash-preview

# File Paths
CONVERSATION_HISTORY_FILE=data/conversation_history.json
SESSION_HANDLE_FILE=data/session_handle.json
LIGHT_STATE_FILE=data/light_state.json
MUSIC_DIRECTORY=music

# Music Configuration
MUSIC_SIMILARITY_THRESHOLD=0.72

# WebSocket Configuration
WEBSOCKET_PING_INTERVAL=10
WEBSOCKET_RECEIVE_TIMEOUT=30
WEBSOCKET_CONFIG_TIMEOUT=10

# Capture Configuration
SAVE_CAPTURED_IMAGE=False
CAPTURED_IMAGES_DIRECTORY=data/images

# Face++ Recognition Configuration
FACEPP_API_KEY=YOUR_FACEPP_API_KEY_HERE
FACEPP_API_SECRET=YOUR_FACEPP_API_SECRET_HERE
FACEPP_COMPARE_URL=https://api-us.faceplusplus.com/facepp/v3/compare
HOST_FACES_DIRECTORY=data/host
FACE_RECOGNITION_THRESHOLD=80.0
FACE_RECOGNITION_ENABLED=True
